# Адрес трекера (с /admin_api/v1 или без) и API-ключ из Профиль -> API ключи
KEITARO_URL=https://your-keitaro.example.com
KEITARO_API_KEY=put-your-key-here

# 1 = работать с встроенным эмулятором Keitaro (без настоящего трекера)
KEITARO_FAKE=0

# PostgreSQL (docker compose up -d db). Для быстрого запуска без Docker: sqlite:///./app.db
DATABASE_URL=postgresql+psycopg://adrobot:adrobot@localhost:5432/adrobot

# Значения по умолчанию для новых кампаний
DEFAULT_DOMAIN=in.posdk.xyz
DEFAULT_GROUP_NAME=FORTESTS
DEFAULT_SOURCE_NAME=FORTESTS
SAFE_REDIRECT_URL=https://google.com
